{
  "name": "reporting-labs",
  "version": "0.6.6",
  "description": "reportingLabs – beautiful, customizable single-file HTML test reports. One line of config. Playwright adapter included, more runners on the way.",
  "keywords": [
    "test-report",
    "html-report",
    "reporter",
    "testing",
    "qa",
    "test-automation",
    "playwright",
    "dashboard"
  ],
  "author": "Naveen Khunteta <naveen@naveenautomationlabs.com>",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "default": "./dist/auto.js"
    }
  },
  "bin": {
    "reporting-labs": "bin/cli.js",
    "rlabs": "bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "fonts",
    "assets/planit-logo.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node bin/build-template.js",
    "demo": "npm run build && cd example && npx playwright test; cd .. && echo 'open example/reporting-labs/index.html'",
    "prepublishOnly": "npm run build",
    "pack:check": "npm run build && npm pack --dry-run"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "jsdom": "^30.1.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naveenautomationlabs/reporting-labs.git"
  },
  "homepage": "https://github.com/naveenautomationlabs/reporting-labs#readme",
  "bugs": {
    "url": "https://github.com/naveenautomationlabs/reporting-labs/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
